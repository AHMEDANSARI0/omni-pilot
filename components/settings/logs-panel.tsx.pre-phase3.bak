'use client';

import * as React from 'react';
import { useApi } from '@/lib/hooks';
import { formatDateTime } from '@/lib/utils';
import type { LogDto } from '@/lib/types';
import { Button, Card, Select, Skeleton } from '../ui/primitives';

const LEVELS = [
  { value: '', label: 'All levels' },
  { value: 'info', label: 'Info' },
  { value: 'warn', label: 'Warnings' },
  { value: 'error', label: 'Errors' },
  { value: 'debug', label: 'Debug' },
];

export function LogsPanel({ timeZone }: { timeZone: string }) {
  const [level, setLevel] = React.useState('');
  const { data, loading, reload } = useApi<{ logs: LogDto[] }>(
    `/logs?limit=150${level ? `&level=${level}` : ''}`,
  );

  return (
    <div className="space-y-3">
      <div className="flex items-center gap-2">
        <Select value={level} onChange={(event) => setLevel(event.target.value)} className="flex-1">
          {LEVELS.map((option) => (
            <option key={option.value} value={option.value}>
              {option.label}
            </option>
          ))}
        </Select>
        <Button variant="outline" size="sm" loading={loading} onClick={reload}>
          Refresh
        </Button>
      </div>

      {loading && !data ? <Skeleton className="h-40 w-full" /> : null}

      <Card className="overflow-hidden">
        <ul className="divide-y divide-border">
          {(data?.logs ?? []).map((log) => (
            <li key={log.id} className="px-3.5 py-2.5">
              <div className="flex items-center justify-between gap-2">
                <p className="truncate text-[12px] font-medium">
                  <span
                    className={`mr-1.5 rounded px-1.5 py-0.5 text-[10px] uppercase ${
                      log.level === 'error'
                        ? 'bg-red-100 text-red-800'
                        : log.level === 'warn'
                          ? 'bg-amber-100 text-amber-800'
                          : 'bg-muted text-muted-foreground'
                    }`}
                  >
                    {log.level}
                  </span>
                  {log.event}
                </p>
                <span className="shrink-0 text-[10px] text-muted-foreground">
                  {formatDateTime(log.createdAt, timeZone)}
                </span>
              </div>
              {log.message ? (
                <p className="mt-0.5 break-words text-[12px] text-muted-foreground">
                  {log.message}
                </p>
              ) : null}
              {Object.keys(log.context ?? {}).length > 0 ? (
                <p className="mt-0.5 break-words text-[10px] text-muted-foreground/80">
                  {JSON.stringify(log.context).slice(0, 240)}
                </p>
              ) : null}
            </li>
          ))}
        </ul>
        {data && data.logs.length === 0 ? (
          <p className="p-4 text-[13px] text-muted-foreground">No log entries for this filter.</p>
        ) : null}
      </Card>
    </div>
  );
}
