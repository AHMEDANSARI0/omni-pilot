'use client';

import * as React from 'react';
import { ExternalLink, Link2, PlugZap, Trash2 } from 'lucide-react';
import { api } from '@/lib/api';
import { useAction, useApi } from '@/lib/hooks';
import { formatDateTime } from '@/lib/utils';
import type { IntegrationsDto } from '@/lib/types';
import {
  Alert,
  Button,
  Card,
  CardContent,
  CardHeader,
  CardTitle,
  Field,
  Input,
} from '../ui/primitives';
import { StatusBadge } from '../status-badge';
import { useToast } from '../toast';
import { WhatsAppPanel } from './whatsapp-panel';

export function IntegrationsPanel({ timeZone }: { timeZone: string }) {
  const { data, loading, reload } = useApi<IntegrationsDto>('/integrations');
  const { busy, run } = useAction();
  const { toast } = useToast();
  const [sheetUrl, setSheetUrl] = React.useState('');
  const [sheetTab, setSheetTab] = React.useState('');
  const [testOutput, setTestOutput] = React.useState<string | null>(null);

  const connect = (provider: 'google_sheets' | 'linkedin') =>
    run(
      () => api.get<{ url: string }>(`/integrations/${provider}/authorize`),
      (result) => {
        window.open(result.url, '_blank', 'noopener,noreferrer');
        toast('Complete the authorization in the new tab, then come back.', 'info');
      },
      (message) => toast(message, 'error'),
    );

  const disconnect = (provider: 'google_sheets' | 'linkedin') =>
    run(
      () => api.delete(`/integrations/${provider}`),
      () => {
        toast('Disconnected.', 'success');
        reload();
      },
      (message) => toast(message, 'error'),
    );

  const saveSheet = () =>
    run(
      () =>
        api.post('/integrations/google-sheets/config', {
          ...(sheetUrl ? { sheetUrl } : {}),
          ...(sheetTab ? { sheetTab } : {}),
        }),
      () => {
        toast('Sheet configuration saved. Run a test to confirm access.', 'success');
        reload();
      },
      (message) => toast(message, 'error'),
    );

  const test = (provider: 'google_sheets' | 'linkedin' | 'resend' | 'gemini') =>
    run(
      () => api.post<{ ok: boolean; message: string }>(`/integrations/${provider}/test`),
      (result) => {
        setTestOutput(`${provider}: ${result.message}`);
        toast(
          result.ok ? 'Test passed.' : 'Test failed - see details below.',
          result.ok ? 'success' : 'error',
        );
        reload();
      },
      (message) => toast(message, 'error'),
    );

  if (loading && !data)
    return <p className="p-2 text-[13px] text-muted-foreground">Loading integrations…</p>;

  return (
    <div className="space-y-3">
      {data?.servicesMode === 'local' ? (
        <Alert tone="warning" title="Local dev mode">
          External services are stubbed. Connect real credentials and set SERVICES_MODE=live (or
          deploy) before expecting real publishing.
        </Alert>
      ) : null}

      <Card>
        <CardHeader className="flex-row items-center justify-between">
          <CardTitle>Google Sheets</CardTitle>
          <StatusBadge status={data?.googleSheets.connected ? 'connected' : 'disconnected'} />
        </CardHeader>
        <CardContent className="space-y-3">
          <p className="text-[12px] text-muted-foreground">
            {data?.googleSheets.connected
              ? `Reading from ${data.googleSheets.sheetLabel}.`
              : data?.googleSheets.configured
                ? 'Authorize Google Sheets so the automation can read and update your content plan.'
                : 'GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are not configured on the server.'}
          </p>
          {data?.googleSheets.lastError ? (
            <p className="rounded bg-red-50 px-2 py-1 text-[12px] text-red-800">
              {data.googleSheets.lastError}
            </p>
          ) : null}
          <div className="flex flex-wrap gap-2">
            <Button size="sm" loading={busy} onClick={() => connect('google_sheets')}>
              <Link2 className="h-4 w-4" aria-hidden />{' '}
              {data?.googleSheets.connected ? 'Reconnect' : 'Connect'}
            </Button>
            <Button
              size="sm"
              variant="outline"
              loading={busy}
              onClick={() => test('google_sheets')}
            >
              <PlugZap className="h-4 w-4" aria-hidden /> Test read
            </Button>
            <Button
              size="sm"
              variant="ghost"
              loading={busy}
              onClick={() => disconnect('google_sheets')}
            >
              <Trash2 className="h-4 w-4" aria-hidden /> Disconnect
            </Button>
          </div>
          <div className="space-y-2 border-t border-border pt-3">
            <Field
              label="Sheet URL or ID"
              htmlFor="sheet-id"
              hint="The spreadsheet the automation should update."
            >
              <Input
                id="sheet-id"
                value={sheetUrl}
                placeholder="https://docs.google.com/spreadsheets/d/…"
                onChange={(event) => setSheetUrl(event.target.value)}
              />
            </Field>
            <Field
              label="Tab name"
              htmlFor="sheet-tab"
              hint="Defaults to the GOOGLE_SHEET_TAB value (Content)."
            >
              <Input
                id="sheet-tab"
                value={sheetTab}
                placeholder="Content"
                onChange={(event) => setSheetTab(event.target.value)}
              />
            </Field>
            <Button
              size="sm"
              variant="outline"
              loading={busy}
              disabled={!sheetUrl && !sheetTab}
              onClick={saveSheet}
            >
              Save sheet configuration
            </Button>
          </div>
        </CardContent>
      </Card>

      <Card>
        <CardHeader className="flex-row items-center justify-between">
          <CardTitle>LinkedIn</CardTitle>
          <StatusBadge
            status={
              data?.linkedin.connected
                ? 'connected'
                : data?.linkedin.needsReauth
                  ? 'needs_reauth'
                  : 'disconnected'
            }
          />
        </CardHeader>
        <CardContent className="space-y-3">
          <p className="text-[12px] text-muted-foreground">
            {data?.linkedin.connected
              ? `Publishing as ${data.linkedin.label ?? 'your profile'}.`
              : data?.linkedin.configured
                ? 'Connect your personal profile to publish through the official Posts API (w_member_social).'
                : 'LINKEDIN_CLIENT_ID / LINKEDIN_CLIENT_SECRET are not configured on the server.'}
          </p>
          {data?.linkedin.expiresAt ? (
            <p className="text-[12px] text-muted-foreground">
              Token expires {formatDateTime(data.linkedin.expiresAt, timeZone)}. Self-serve LinkedIn
              apps get 60-day tokens with no refresh token, so reconnect before it lapses.
            </p>
          ) : null}
          <div className="flex flex-wrap gap-2">
            <Button size="sm" loading={busy} onClick={() => connect('linkedin')}>
              <Link2 className="h-4 w-4" aria-hidden />{' '}
              {data?.linkedin.connected ? 'Reconnect' : 'Connect LinkedIn'}
            </Button>
            <Button size="sm" variant="outline" loading={busy} onClick={() => test('linkedin')}>
              <PlugZap className="h-4 w-4" aria-hidden /> Check status
            </Button>
            <Button size="sm" variant="ghost" loading={busy} onClick={() => disconnect('linkedin')}>
              <Trash2 className="h-4 w-4" aria-hidden /> Disconnect
            </Button>
          </div>
          <Alert tone="info">
            If LinkedIn access is unavailable, approved posts fall back to a clearly labelled manual
            publish flow with the full text and a link. Nothing is ever marked published unless
            LinkedIn confirms it.
          </Alert>
        </CardContent>
      </Card>

      <WhatsAppPanel />

      <Card>
        <CardHeader className="flex-row items-center justify-between">
          <CardTitle>Email (Resend)</CardTitle>
          <StatusBadge status={data?.email.connected ? 'connected' : 'disconnected'} />
        </CardHeader>
        <CardContent className="space-y-3">
          <p className="text-[12px] text-muted-foreground">
            From: {data?.email.fromEmail ?? 'not configured'} · free tier allows 100 emails/day.
          </p>
          <Button size="sm" variant="outline" loading={busy} onClick={() => test('resend')}>
            <ExternalLink className="h-4 w-4" aria-hidden /> Send test email
          </Button>
        </CardContent>
      </Card>

      <Card>
        <CardHeader className="flex-row items-center justify-between">
          <CardTitle>AI provider</CardTitle>
          <StatusBadge status="connected" />
        </CardHeader>
        <CardContent className="space-y-3">
          <p className="text-[12px] text-muted-foreground">
            {data?.ai.provider} · {data?.ai.model}. The API key is stored as a Worker secret and
            never reaches the browser.
          </p>
          <Button size="sm" variant="outline" loading={busy} onClick={() => test('gemini')}>
            <PlugZap className="h-4 w-4" aria-hidden /> Test generation
          </Button>
        </CardContent>
      </Card>

      {testOutput ? (
        <Alert tone="info" title="Last test">
          {testOutput}
        </Alert>
      ) : null}
    </div>
  );
}
