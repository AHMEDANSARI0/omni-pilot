import { Badge, type BadgeTone } from './ui/primitives';

const POST_TONES: Record<string, { tone: BadgeTone; label: string }> = {
  draft: { tone: 'neutral', label: 'Draft' },
  pending_approval: { tone: 'amber', label: 'Awaiting approval' },
  approved: { tone: 'blue', label: 'Approved' },
  rejected: { tone: 'red', label: 'Rejected' },
  expired: { tone: 'neutral', label: 'Expired' },
  publishing: { tone: 'violet', label: 'Publishing' },
  published: { tone: 'green', label: 'Published' },
  failed: { tone: 'red', label: 'Failed' },
  pending: { tone: 'amber', label: 'Pending' },
  claimed: { tone: 'violet', label: 'Processing' },
  generated: { tone: 'indigo', label: 'Generated' },
  skipped: { tone: 'neutral', label: 'Skipped' },
  queued: { tone: 'amber', label: 'Queued' },
  processing: { tone: 'violet', label: 'Processing' },
  manual_required: { tone: 'violet', label: 'Manual publish' },
  canceled: { tone: 'neutral', label: 'Canceled' },
  connected: { tone: 'green', label: 'Connected' },
  disconnected: { tone: 'neutral', label: 'Not connected' },
  needs_reauth: { tone: 'amber', label: 'Reconnect needed' },
  error: { tone: 'red', label: 'Error' },
  approved_action: { tone: 'green', label: 'Approved' },
};

export function StatusBadge({ status }: { status: string }) {
  const config = POST_TONES[status] ?? { tone: 'neutral' as BadgeTone, label: status };
  return (
    <Badge tone={config.tone}>
      <span aria-hidden className="h-1.5 w-1.5 rounded-full bg-current opacity-70" />
      {config.label}
    </Badge>
  );
}
