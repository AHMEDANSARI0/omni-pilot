'use client';

import * as React from 'react';
import { usePathname } from 'next/navigation';
import { useApi } from '@/lib/hooks';
import type { SummaryDto } from '@/lib/types';
import { MobileNav } from './layout/mobile-nav';
import { Sidebar } from './layout/sidebar';
import { Topbar } from './layout/topbar';
import { useAuthMode } from './auth-guard';

export function AppShell({ children }: { children: React.ReactNode }) {
  const pathname = usePathname();
  const mode = useAuthMode();
  const summary = useApi<SummaryDto>('/overview/summary');
  const reloadSummary = summary.reload;

  React.useEffect(() => {
    reloadSummary();
  }, [pathname, reloadSummary]);

  const pending = summary.data?.pendingApprovals ?? 0;

  return (
    <div className="min-h-screen bg-canvas">
      <Sidebar pathname={pathname} mode={mode} />
      <div className="lg:pl-[248px]">
        <Topbar pathname={pathname} mode={mode} pendingApprovals={pending} />
        {mode?.servicesMode === 'local' ? (
          <div className="border-b border-warning/20 bg-warning-soft px-4 py-1.5 text-[11.5px] text-warning-foreground lg:px-8">
            Local mode: AI, email, Sheets and LinkedIn are stubbed. Nothing is really published.
          </div>
        ) : null}
        <main className="mx-auto w-full max-w-[1180px] px-4 py-4 pb-24 sm:px-5 lg:px-8 lg:py-6 lg:pb-10">
          {children}
        </main>
      </div>
      <MobileNav pathname={pathname} />
    </div>
  );
}
