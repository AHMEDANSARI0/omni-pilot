'use client';

import Link from 'next/link';
import {
  AlertTriangle,
  ArrowUpRight,
  CheckCircle2,
  CircleSlash,
  Clock3,
  FileText,
} from 'lucide-react';
import { Card, CardContent, CardHeader, CardTitle } from './ui/primitives';
import { StatusBadge } from './status-badge';
import { formatDateTime, relativeTime, truncate } from '@/lib/utils';
import type { LogDto, PostDto } from '@/lib/types';

export function StatCard({
  label,
  value,
  icon,
  tone = 'default',
  href,
}: {
  label: string;
  value: number | string;
  icon: React.ReactNode;
  tone?: 'default' | 'amber' | 'green' | 'red';
  href?: string;
}) {
  const tones = {
    default: 'text-foreground',
    amber: 'text-amber-700',
    green: 'text-emerald-700',
    red: 'text-red-700',
  } as const;

  const body = (
    <Card className="h-full">
      <CardContent className="flex items-start justify-between gap-2 p-3.5">
        <div className="min-w-0">
          <p className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
            {label}
          </p>
          <p className={`mt-1 text-2xl font-semibold tabular-nums ${tones[tone]}`}>{value}</p>
        </div>
        <span className={`shrink-0 rounded-lg bg-muted p-2 ${tones[tone]}`} aria-hidden>
          {icon}
        </span>
      </CardContent>
    </Card>
  );

  return href ? (
    <Link
      href={href}
      className="block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-xl"
    >
      {body}
    </Link>
  ) : (
    body
  );
}

export function IntegrationRow({
  name,
  detail,
  status,
  href,
}: {
  name: string;
  detail: string;
  status: string;
  href?: string;
}) {
  const content = (
    <div className="flex items-center justify-between gap-3 border-b border-border px-4 py-3 last:border-b-0">
      <div className="min-w-0">
        <p className="text-sm font-medium">{name}</p>
        <p className="truncate text-xs text-muted-foreground">{detail}</p>
      </div>
      <div className="flex shrink-0 items-center gap-1.5">
        <StatusBadge status={status} />
        {href ? <ArrowUpRight className="h-4 w-4 text-muted-foreground" aria-hidden /> : null}
      </div>
    </div>
  );
  return href ? <Link href={href}>{content}</Link> : content;
}

export function NextRunCard({
  nextRunAt,
  timeZone,
  dueNow,
  reason,
  lastRunAt,
  lastRunStatus,
}: {
  nextRunAt: string | null;
  timeZone: string;
  dueNow: boolean;
  reason: string;
  lastRunAt: string | null;
  lastRunStatus: string | null;
}) {
  return (
    <Card>
      <CardHeader className="flex-row items-center justify-between">
        <CardTitle>Next scheduled run</CardTitle>
        <Clock3 className="h-4 w-4 text-muted-foreground" aria-hidden />
      </CardHeader>
      <CardContent className="space-y-1">
        <p className="text-lg font-semibold">
          {nextRunAt ? formatDateTime(nextRunAt, timeZone) : 'No upcoming slot'}
        </p>
        <p className="text-xs text-muted-foreground">
          {timeZone} · {dueNow ? 'Generation window is open now' : reason}
        </p>
        <p className="pt-1 text-xs text-muted-foreground">
          Last run:{' '}
          {lastRunAt ? `${relativeTime(lastRunAt)} (${lastRunStatus ?? 'unknown'})` : 'never'}
        </p>
      </CardContent>
    </Card>
  );
}

export function PostPreviewCard({ post, timeZone }: { post: PostDto; timeZone: string }) {
  return (
    <Card>
      <CardContent className="space-y-2 p-4">
        <div className="flex items-center justify-between gap-2">
          <p className="text-xs font-medium text-muted-foreground">{post.runDate}</p>
          <StatusBadge status={post.status} />
        </div>
        <p className="text-sm font-medium leading-snug">{truncate(post.hook, 120)}</p>
        <p className="whitespace-pre-wrap text-[13px] leading-relaxed text-muted-foreground">
          {truncate(post.fullText, 220)}
        </p>
        <div className="flex items-center justify-between pt-1 text-[11px] text-muted-foreground">
          <span>
            {post.charCount} chars · {post.hashtags.length} hashtags
          </span>
          <span>
            {post.source === 'local-dev' ? 'local-dev content' : post.model || post.provider}
          </span>
        </div>
      </CardContent>
    </Card>
  );
}

export function ActivityList({ logs, timeZone }: { logs: LogDto[]; timeZone: string }) {
  if (logs.length === 0) {
    return <p className="px-1 py-3 text-[13px] text-muted-foreground">No activity recorded yet.</p>;
  }
  const icons = {
    error: <AlertTriangle className="h-3.5 w-3.5 text-red-600" aria-hidden />,
    warn: <AlertTriangle className="h-3.5 w-3.5 text-amber-600" aria-hidden />,
    info: <CheckCircle2 className="h-3.5 w-3.5 text-emerald-600" aria-hidden />,
    debug: <CircleSlash className="h-3.5 w-3.5 text-muted-foreground" aria-hidden />,
  } as const;

  return (
    <ul className="divide-y divide-border">
      {logs.map((log) => (
        <li key={log.id} className="flex items-start gap-2.5 px-4 py-2.5">
          <span className="mt-0.5 shrink-0">{icons[log.level]}</span>
          <div className="min-w-0 flex-1">
            <p className="truncate text-[13px] font-medium">{log.event}</p>
            {log.message ? (
              <p className="line-clamp-2 break-words text-xs text-muted-foreground">
                {log.message}
              </p>
            ) : null}
          </div>
          <span
            className="shrink-0 text-[11px] text-muted-foreground"
            title={formatDateTime(log.createdAt, timeZone)}
          >
            {relativeTime(log.createdAt)}
          </span>
        </li>
      ))}
    </ul>
  );
}

export function PostsEmpty({ children }: { children: React.ReactNode }) {
  return (
    <div className="flex flex-col items-center gap-2 py-6 text-center text-[13px] text-muted-foreground">
      <FileText className="h-5 w-5" aria-hidden />
      {children}
    </div>
  );
}
