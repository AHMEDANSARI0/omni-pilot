import { describe, expect, it } from 'vitest';
import { generateDailyPost } from '@/src/core/generation';
import { approvalEmail, createHarness, extractTokenFromEmail } from './helpers';

describe('daily generation pipeline', () => {
  it('generates, persists, updates the sheet and emails an approval request', async () => {
    const harness = createHarness();
    const result = await generateDailyPost(harness.services, { trigger: 'test' });

    expect(result.status).toBe('generated');
    if (result.status !== 'generated') throw new Error('expected generated');

    expect(result.post.status).toBe('pending_approval');
    expect(result.post.runDate).toBe('2026-11-16');
    expect(result.post.hashtags.length).toBeGreaterThanOrEqual(3);
    expect(result.post.fullText).toContain('#');
    expect(result.post.charCount).toBeGreaterThan(300);
    expect(result.approvalEmailSent).toBe(true);
    expect(result.sheetUpdated).toBe(true);
    expect(result.sync?.imported).toBe(1);

    const posts = harness.db.allPosts();
    expect(posts).toHaveLength(1);

    const topic = await harness.db.listTopics();
    expect(topic[0]?.status).toBe('generated');

    const email = approvalEmail(harness);
    expect(email.subject).toContain('Approve LinkedIn post for 2026-11-16');
    expect(email.html).toContain(result.post.fullText.split('\n')[0]!.slice(0, 20));
    const token = extractTokenFromEmail(email.html);
    expect(email.text).toContain('Nothing is published until you approve');

    const approvals = harness.db.allApprovals();
    expect(approvals).toHaveLength(1);
    expect(approvals[0]?.tokenHash).not.toBe(token);
    expect(approvals[0]?.tokenHash).toMatch(/^[a-f0-9]{64}$/);
    expect(approvals[0]?.status).toBe('pending');
    expect(approvals[0]?.emailSentAt).not.toBeNull();
    expect(approvals[0]?.emailMessageId).toBe('msg-1');

    // 48h expiry from the harness clock
    expect(approvals[0]?.expiresAt).toBe('2026-11-18T03:05:00.000Z');

    const sheetUpdate = harness.sheets.updates[0];
    expect(sheetUpdate).toMatchObject({ rowNumber: 2, status: 'Generated', approval: 'Pending' });
    expect(sheetUpdate?.generatedPost).toBe(result.post.fullText);
    expect(sheetUpdate?.hashtags).toContain('#');
  });

  it('never generates twice for the same day', async () => {
    const harness = createHarness();
    const first = await generateDailyPost(harness.services, { trigger: 'test' });
    expect(first.status).toBe('generated');

    const second = await generateDailyPost(harness.services, { trigger: 'test' });
    expect(second.status).toBe('duplicate');
    expect(harness.db.allPosts()).toHaveLength(1);
    expect(harness.ai.calls).toHaveLength(1);
    expect(
      harness.email.sent.filter((message) => message.subject.includes('Approve')),
    ).toHaveLength(1);
  });

  it('reports no_topic and notifies instead of inventing content', async () => {
    const harness = createHarness({ sheetRows: [] });
    const result = await generateDailyPost(harness.services, { trigger: 'test' });
    expect(result.status).toBe('no_topic');
    expect(harness.db.allPosts()).toHaveLength(0);
    expect(harness.ai.calls).toHaveLength(0);
    expect(harness.email.sent.some((message) => message.subject.includes('No topic'))).toBe(true);
  });

  it('only uses topics for the requested date', async () => {
    const harness = createHarness({
      sheetRows: [{ date: '2026-11-17', topic: 'Tomorrow topic' }],
    });
    const result = await generateDailyPost(harness.services, {
      trigger: 'test',
      runDate: '2026-11-16',
    });
    expect(result.status).toBe('no_topic');
  });

  it('marks the topic failed and notifies when the AI provider errors', async () => {
    const harness = createHarness();
    harness.ai.responses = [new Error('Gemini quota exceeded'), new Error('Gemini quota exceeded')];
    const result = await generateDailyPost(harness.services, { trigger: 'test' });

    expect(result.status).toBe('failed');
    const posts = harness.db.allPosts();
    expect(posts).toHaveLength(0);
    const topics = await harness.db.listTopics();
    expect(topics[0]?.status).toBe('failed');
    expect(topics[0]?.lastError).toContain('quota exceeded');
    expect(
      harness.email.sent.some((message) => message.subject.includes('Automation failure')),
    ).toBe(true);
  });

  it('retries generation once when the draft is unusable, then succeeds', async () => {
    const harness = createHarness();
    harness.ai.responses = [
      { hook: 'Short.', body: 'Too short.', hashtags: [] },
      {
        hook: 'Idempotency keys solved our duplicate agent records.',
        body: 'We stored the result of every tool call before returning, so retries could resume instead of repeating work.\n\nThat single change removed duplicate records and made failures readable.',
        hashtags: ['AgenticAI', 'Python', 'Automation'],
      },
    ];
    const result = await generateDailyPost(harness.services, { trigger: 'test' });
    expect(result.status).toBe('generated');
    expect(harness.ai.calls).toHaveLength(2);
    expect(harness.ai.calls[1]?.writingInstructions).toContain('previous draft had these problems');
  });

  it('fails clearly when generated content stays invalid', async () => {
    const harness = createHarness();
    const invalid = { hook: 'Short.', body: 'Too short.', hashtags: [] };
    harness.ai.responses = [invalid, invalid];
    const result = await generateDailyPost(harness.services, { trigger: 'test' });
    expect(result.status).toBe('failed');
    if (result.status === 'failed') expect(result.stage).toBe('ai_generation');
    expect(harness.db.allPosts()).toHaveLength(0);
  });

  it('keeps the draft and reports the failure when the approval email cannot be sent', async () => {
    const harness = createHarness();
    harness.email.failNext = 1;
    const result = await generateDailyPost(harness.services, { trigger: 'test' });
    expect(result.status).toBe('generated');
    if (result.status !== 'generated') throw new Error('expected generated');
    expect(result.approvalEmailSent).toBe(false);
    expect(result.approvalEmailError).toContain('Simulated email failure');
    expect(result.post.status).toBe('pending_approval');
    const approvals = harness.db.allApprovals();
    expect(approvals[0]?.emailSentAt).toBeNull();
    expect(
      harness.email.sent.some((message) => message.subject.includes('Automation failure')),
    ).toBe(true);
  });

  it('still generates from stored topics when Google Sheets is unavailable', async () => {
    const harness = createHarness();
    harness.sheets.failReads = true;
    harness.db.seedTopic({ topic: 'Stored topic fallback', topicDate: '2026-11-16' });
    const result = await generateDailyPost(harness.services, { trigger: 'test' });
    expect(result.status).toBe('generated');
    if (result.status !== 'generated') throw new Error('expected generated');
    expect(result.syncError).toContain('Simulated sheets read failure');
  });

  it('records a sheet write failure without losing the post', async () => {
    const harness = createHarness();
    harness.sheets.failUpdates = true;
    const result = await generateDailyPost(harness.services, { trigger: 'test' });
    expect(result.status).toBe('generated');
    if (result.status !== 'generated') throw new Error('expected generated');
    expect(result.sheetUpdated).toBe(false);
    expect(harness.db.allPosts()).toHaveLength(1);
    const logs = await harness.db.listLogs({ event: 'generation.sheet_updated.failed' });
    expect(logs).toHaveLength(1);
  });

  it('avoids repeating recent hooks by passing them to the model', async () => {
    const harness = createHarness();
    await harness.db.createPost({
      topicId: null,
      runDate: '2026-11-13',
      hook: 'An older hook about retries.',
      body: 'body text that is long enough to look real for the purposes of this test case.',
      hashtags: ['#AI'],
      fullText: 'An older hook about retries.\n\nbody text.\n\n#AI',
      charCount: 70,
      provider: 'fake',
      model: 'fake',
      status: 'published',
      source: 'ai',
    });
    await generateDailyPost(harness.services, { trigger: 'test' });
    expect(harness.ai.calls[0]?.recentHooks).toContain('An older hook about retries.');
  });
});
