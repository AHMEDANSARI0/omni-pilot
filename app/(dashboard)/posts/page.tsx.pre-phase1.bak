'use client';

import * as React from 'react';
import { api } from '@/lib/api';
import { useAction, useApi } from '@/lib/hooks';
import type { PostDto, SettingsDto } from '@/lib/types';
import { Alert, Button, Card, CardContent, EmptyState, Skeleton } from '@/components/ui/primitives';
import { StatusBadge } from '@/components/status-badge';
import { PostActions } from '@/components/post-actions';
import { useToast } from '@/components/toast';

const FILTERS = [
  { value: '', label: 'All' },
  { value: 'pending_approval', label: 'Pending' },
  { value: 'approved', label: 'Approved' },
  { value: 'published', label: 'Published' },
  { value: 'failed', label: 'Failed' },
  { value: 'rejected', label: 'Rejected' },
] as const;

export default function PostsPage() {
  const [status, setStatus] = React.useState('');
  const [expanded, setExpanded] = React.useState<Record<string, boolean>>({});
  React.useEffect(() => {
    const param = new URLSearchParams(window.location.search).get('status');
    if (param) setStatus(param);
  }, []);

  const query = `/content/posts?limit=50${status ? `&status=${status}` : ''}`;
  const { data, error, loading, reload } = useApi<{ posts: PostDto[] }>(query);
  const settings = useApi<{ settings: SettingsDto }>('/settings');
  const timeZone = settings.data?.settings.ownerTimezone ?? 'UTC';
  const { busy, run } = useAction();
  const { toast } = useToast();

  const generateNow = () =>
    run(
      () => api.post<{ result: { status: string; reason?: string } }>('/content/generate', {}),
      (result) => {
        toast(
          `Generation: ${result.result.status}${result.result.reason ? ` — ${result.result.reason}` : ''}`,
          'success',
        );
        reload();
      },
      (message) => toast(message, 'error'),
    );

  return (
    <div className="space-y-3">
      <div className="-mx-4 overflow-x-auto px-4">
        <div className="flex w-max gap-1.5">
          {FILTERS.map((filter) => (
            <button
              key={filter.value}
              type="button"
              onClick={() => setStatus(filter.value)}
              className={`h-9 whitespace-nowrap rounded-full border px-3 text-[13px] font-medium transition-colors ${
                status === filter.value
                  ? 'border-primary bg-primary text-primary-foreground'
                  : 'border-border bg-card text-foreground'
              }`}
            >
              {filter.label}
            </button>
          ))}
        </div>
      </div>

      <div className="flex gap-2">
        <Button className="flex-1" size="sm" variant="outline" loading={busy} onClick={generateNow}>
          Generate post now
        </Button>
        <Button size="sm" variant="ghost" onClick={reload} loading={loading}>
          Refresh
        </Button>
      </div>

      {error ? (
        <Alert tone="error" title="Could not load posts">
          {error}
        </Alert>
      ) : null}

      {loading && !data ? (
        <div className="space-y-3">
          <Skeleton className="h-36 w-full" />
          <Skeleton className="h-36 w-full" />
        </div>
      ) : null}

      {data && data.posts.length === 0 ? (
        <EmptyState
          title="No posts in this view"
          description="Add topics to your Google Sheet (or the Queue tab) and the scheduler will generate a post on the next publishing day."
        />
      ) : null}

      <div className="space-y-3">
        {(data?.posts ?? []).map((post) => {
          const isExpanded = expanded[post.id] ?? false;
          return (
            <Card key={post.id}>
              <CardContent className="space-y-2.5 p-4">
                <div className="flex items-center justify-between gap-2">
                  <div className="flex min-w-0 items-center gap-2">
                    <p className="text-xs font-medium text-muted-foreground">{post.runDate}</p>
                    {post.editedByOwner ? (
                      <span className="rounded bg-muted px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">
                        edited
                      </span>
                    ) : null}
                    {post.source === 'local-dev' ? (
                      <span className="rounded bg-violet-50 px-1.5 py-0.5 text-[10px] font-medium text-violet-700">
                        local-dev
                      </span>
                    ) : null}
                  </div>
                  <StatusBadge status={post.status} />
                </div>

                <p className="break-words text-sm font-medium leading-snug">{post.hook}</p>
                <div
                  className={`whitespace-pre-wrap break-words text-[13px] leading-relaxed text-foreground/90 ${isExpanded ? '' : 'line-clamp-4'}`}
                >
                  {post.body}
                </div>
                {post.hashtags.length > 0 ? (
                  <p className="text-[12px] font-medium text-primary">{post.hashtags.join(' ')}</p>
                ) : null}
                <div className="flex items-center justify-between text-[11px] text-muted-foreground">
                  <span>
                    {post.charCount} chars · {post.model || post.provider}
                  </span>
                  <button
                    type="button"
                    className="font-medium text-primary"
                    onClick={() =>
                      setExpanded((current) => ({ ...current, [post.id]: !isExpanded }))
                    }
                  >
                    {isExpanded ? 'Show less' : 'Read full'}
                  </button>
                </div>

                {post.publishedUrl ? (
                  <a
                    href={post.publishedUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="block truncate text-[12px] text-primary underline-offset-2 hover:underline"
                  >
                    {post.publishedUrl}
                  </a>
                ) : null}

                <PostActions post={post} onDone={reload} />
                <p className="text-[10px] text-muted-foreground">
                  Created {new Date(post.createdAt).toLocaleString('en-GB')} · {timeZone}
                </p>
              </CardContent>
            </Card>
          );
        })}
      </div>
    </div>
  );
}
