'use client';

import Link from 'next/link';
import { CheckCircle2, FileText, Send, XCircle } from 'lucide-react';
import { api } from '@/lib/api';
import { useAction, useApi } from '@/lib/hooks';
import type { OverviewDto } from '@/lib/types';
import {
  Alert,
  Button,
  Card,
  CardContent,
  CardHeader,
  CardTitle,
  EmptyState,
  SectionTitle,
  Skeleton,
} from '@/components/ui/primitives';
import {
  ActivityList,
  IntegrationRow,
  NextRunCard,
  PostPreviewCard,
  StatCard,
} from '@/components/dashboard-cards';
import { useToast } from '@/components/toast';

export default function OverviewPage() {
  const { data, error, loading, reload } = useApi<OverviewDto>('/overview');
  const { busy, run } = useAction();
  const { toast } = useToast();

  if (loading && !data) {
    return (
      <div className="space-y-3">
        <Skeleton className="h-20 w-full" />
        <Skeleton className="h-28 w-full" />
        <Skeleton className="h-40 w-full" />
      </div>
    );
  }

  if (error && !data) {
    return (
      <Alert tone="error" title="Could not load the dashboard">
        {error}
      </Alert>
    );
  }

  if (!data) return null;

  const { stats, schedule, integrations, latestPosts, recentLogs } = data;
  const timeZone = schedule.settings.ownerTimezone;

  return (
    <div className="space-y-4">
      <div className="grid grid-cols-2 gap-2.5">
        <StatCard
          label="Generated"
          value={stats.total}
          icon={<FileText className="h-4 w-4" />}
          href="/posts/"
        />
        <StatCard
          label="Pending approval"
          value={stats.pendingApprovals}
          tone="amber"
          icon={<CheckCircle2 className="h-4 w-4" />}
          href="/approvals/"
        />
        <StatCard
          label="Published"
          value={stats.published}
          tone="green"
          icon={<Send className="h-4 w-4" />}
          href="/history/"
        />
        <StatCard
          label="Failed"
          value={stats.failed}
          tone="red"
          icon={<XCircle className="h-4 w-4" />}
          href="/posts/?status=failed"
        />
      </div>

      <NextRunCard
        nextRunAt={schedule.nextSlot?.generationAt ?? null}
        timeZone={timeZone}
        dueNow={schedule.generationDueNow}
        reason={schedule.generationReason}
        lastRunAt={schedule.schedulerState.lastGenerationAt}
        lastRunStatus={schedule.schedulerState.lastGenerationStatus}
      />

      <div className="flex gap-2">
        <Button
          className="flex-1"
          loading={busy}
          onClick={() =>
            run(
              () => api.post<{ generation: { reason: string } }>('/schedule/run', { force: true }),
              (result) => {
                toast(`Run complete: ${result.generation.reason}`, 'success');
                reload();
              },
              (message) => toast(message, 'error'),
            )
          }
        >
          Run now
        </Button>
        <Link href="/approvals/" className="flex-1">
          <Button variant="outline" className="w-full">
            Review approvals
          </Button>
        </Link>
      </div>

      {stats.pendingApprovals > 0 ? (
        <Alert tone="warning" title={`${stats.pendingApprovals} post(s) waiting for your approval`}>
          Nothing is published until you approve. Review them from the Approvals tab or the email
          link.
        </Alert>
      ) : null}

      <section>
        <SectionTitle
          action={
            <Link href="/settings/?tab=integrations" className="text-xs font-medium text-primary">
              Manage
            </Link>
          }
        >
          Integrations
        </SectionTitle>
        <Card className="overflow-hidden">
          <IntegrationRow
            name="Google Sheets"
            detail={
              integrations.googleSheets.connected
                ? integrations.googleSheets.sheetLabel
                : 'Connect to load topics'
            }
            status={integrations.googleSheets.connected ? 'connected' : 'disconnected'}
            href="/settings/?tab=integrations"
          />
          <IntegrationRow
            name="LinkedIn"
            detail={
              integrations.linkedin.connected
                ? `${integrations.linkedin.label ?? 'Connected'}${integrations.linkedin.expiresAt ? ` · token expires ${integrations.linkedin.expiresAt.slice(0, 10)}` : ''}`
                : integrations.linkedin.needsReauth
                  ? 'Reconnect required to publish automatically'
                  : 'Not connected - manual publishing only'
            }
            status={
              integrations.linkedin.connected
                ? 'connected'
                : integrations.linkedin.needsReauth
                  ? 'needs_reauth'
                  : 'disconnected'
            }
            href="/settings/?tab=integrations"
          />
          <IntegrationRow
            name="Email (Resend)"
            detail={
              integrations.email.connected
                ? integrations.email.fromEmail
                : 'Approval emails will not be sent'
            }
            status={integrations.email.connected ? 'connected' : 'disconnected'}
            href="/settings/?tab=integrations"
          />
          <IntegrationRow
            name="AI provider"
            detail={`${integrations.ai.provider} · ${integrations.ai.model}`}
            status="connected"
            href="/settings/?tab=ai"
          />
        </Card>
      </section>

      <section>
        <SectionTitle
          action={
            <Link href="/posts/" className="text-xs font-medium text-primary">
              All posts
            </Link>
          }
        >
          Latest posts
        </SectionTitle>
        {latestPosts.length === 0 ? (
          <EmptyState
            title="No posts yet"
            description="Add topics to your Google Sheet, then the scheduler generates one post per publishing day."
          />
        ) : (
          <div className="space-y-2.5">
            {latestPosts.slice(0, 3).map((post) => (
              <PostPreviewCard key={post.id} post={post} timeZone={timeZone} />
            ))}
          </div>
        )}
      </section>

      <section>
        <SectionTitle
          action={
            <Link href="/settings/?tab=logs" className="text-xs font-medium text-primary">
              All logs
            </Link>
          }
        >
          Recent activity
        </SectionTitle>
        <Card className="overflow-hidden">
          <ActivityList logs={recentLogs} timeZone={timeZone} />
        </Card>
      </section>

      {data.upcomingTopics.length > 0 ? (
        <section>
          <SectionTitle>Upcoming topics</SectionTitle>
          <Card>
            <CardContent className="divide-y divide-border p-0">
              {data.upcomingTopics.map((topic) => (
                <div key={topic.id} className="flex items-start justify-between gap-2 px-4 py-2.5">
                  <div className="min-w-0">
                    <p className="truncate text-[13px] font-medium">{topic.topic}</p>
                    <p className="text-[11px] text-muted-foreground">
                      {topic.topicDate} · {topic.contentType}
                      {topic.sheetRowNumber ? ` · sheet row ${topic.sheetRowNumber}` : ''}
                    </p>
                  </div>
                  <span className="shrink-0 text-[11px] capitalize text-muted-foreground">
                    {topic.status}
                  </span>
                </div>
              ))}
            </CardContent>
          </Card>
        </section>
      ) : null}
    </div>
  );
}
