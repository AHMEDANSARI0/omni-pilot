'use client';

import { ExternalLink } from 'lucide-react';
import { useApi } from '@/lib/hooks';
import { formatDateTime } from '@/lib/utils';
import type { SettingsDto } from '@/lib/types';
import { Alert, Card, CardContent, EmptyState, Skeleton } from '@/components/ui/primitives';

interface HistoryItem {
  id: string;
  runDate: string;
  publishedUrl: string | null;
  publishedAt: string | null;
  hook: string;
  charCount: number;
  source: string;
}

export default function HistoryPage() {
  const { data, error, loading } = useApi<{ history: HistoryItem[] }>('/publishing/history');
  const settings = useApi<{ settings: SettingsDto }>('/settings');
  const timeZone = settings.data?.settings.ownerTimezone ?? 'UTC';

  if (loading && !data) return <Skeleton className="h-40 w-full" />;
  if (error) {
    return (
      <Alert tone="error" title="Could not load publishing history">
        {error}
      </Alert>
    );
  }

  const history = data?.history ?? [];
  if (history.length === 0) {
    return (
      <EmptyState
        title="Nothing published yet"
        description="Approved and published posts appear here with the LinkedIn URL recorded by the API."
      />
    );
  }

  return (
    <div className="space-y-2.5">
      <p className="px-1 text-xs text-muted-foreground">{history.length} published post(s)</p>
      {history.map((item) => (
        <Card key={item.id}>
          <CardContent className="space-y-1.5 p-4">
            <div className="flex items-center justify-between gap-2">
              <p className="text-xs font-medium text-muted-foreground">{item.runDate}</p>
              <p className="text-[11px] text-muted-foreground">
                {item.publishedAt ? formatDateTime(item.publishedAt, timeZone) : 'time unknown'}
              </p>
            </div>
            <p className="break-words text-[13px] font-medium leading-snug">{item.hook}</p>
            {item.publishedUrl ? (
              <a
                href={item.publishedUrl}
                target="_blank"
                rel="noopener noreferrer"
                className="flex items-center gap-1 truncate text-[12px] text-primary hover:underline"
              >
                <ExternalLink className="h-3.5 w-3.5 shrink-0" aria-hidden />
                <span className="truncate">{item.publishedUrl}</span>
              </a>
            ) : (
              <p className="text-[12px] text-amber-700">Published without a recorded URL.</p>
            )}
            <p className="text-[11px] text-muted-foreground">
              {item.charCount} characters{item.source === 'local-dev' ? ' · local-dev content' : ''}
            </p>
          </CardContent>
        </Card>
      ))}
    </div>
  );
}
