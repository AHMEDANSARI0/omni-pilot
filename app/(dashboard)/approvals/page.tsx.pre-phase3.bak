'use client';

import * as React from 'react';
import { Mail, MailWarning } from 'lucide-react';
import { api } from '@/lib/api';
import { useAction, useApi } from '@/lib/hooks';
import { formatDateTime } from '@/lib/utils';
import type { ApprovalDto, PostDto, SettingsDto } from '@/lib/types';
import { Alert, Button, Card, CardContent, EmptyState, Skeleton } from '@/components/ui/primitives';
import { StatusBadge } from '@/components/status-badge';
import { PostActions } from '@/components/post-actions';
import { useToast } from '@/components/toast';

interface PendingResponse {
  approvals: Array<{ approval: ApprovalDto; post: PostDto }>;
}

export default function ApprovalsPage() {
  const { data, error, loading, reload } = useApi<PendingResponse>('/approvals?status=pending');
  const settings = useApi<{ settings: SettingsDto }>('/settings');
  const timeZone = settings.data?.settings.ownerTimezone ?? 'UTC';
  const { busy, run } = useAction();
  const { toast } = useToast();
  const [expanded, setExpanded] = React.useState<Record<string, boolean>>({});
  const [decided, setDecided] = React.useState<Record<string, true>>({});
  const [localStatus, setLocalStatus] = React.useState<Record<string, string>>({});

  const resend = (postId: string) =>
    run(
      () => api.post<{ sent: boolean; error: string | null }>(`/approvals/${postId}/resend`),
      (result) => {
        toast(
          result.sent ? 'Approval email re-sent.' : `Could not send: ${result.error}`,
          result.sent ? 'success' : 'error',
        );
        reload();
      },
      (message) => toast(message, 'error'),
    );

  if (loading && !data) {
    return (
      <div className="space-y-3">
        <Skeleton className="h-32 w-full" />
        <Skeleton className="h-32 w-full" />
      </div>
    );
  }

  if (error) {
    return (
      <Alert tone="error" title="Could not load approvals">
        {error}
      </Alert>
    );
  }

  const approvals = (data?.approvals ?? []).filter((item) => !decided[item.post.id]);

  if (approvals.length === 0) {
    return (
      <EmptyState
        title="Nothing to approve"
        description="When the scheduler generates a post you will get an email with a secure approval link. Pending posts also appear here."
      />
    );
  }

  return (
    <div className="space-y-3">
      <Alert tone="info" title="Publishing is gated on your approval">
        Approve to publish at the scheduled time, or reject to skip the topic. Links expire
        automatically.
      </Alert>

      {approvals.map(({ approval, post }) => {
        const isExpanded = expanded[post.id] ?? false;
        const expiresIn = new Date(approval.expiresAt).getTime() - Date.now();
        const hoursLeft = Math.max(0, Math.round(expiresIn / 3_600_000));
        return (
          <Card key={post.id}>
            <CardContent className="space-y-3 p-4">
              <div className="flex items-center justify-between gap-2">
                <p className="text-[11.5px] font-medium text-muted-foreground">{post.runDate}</p>
                <StatusBadge status={localStatus[post.id] ?? post.status} />
              </div>

              <div className="rounded-lg border border-border bg-canvas p-3">
                <p
                  className={`whitespace-pre-wrap break-words text-[13px] leading-relaxed ${isExpanded ? '' : 'line-clamp-[10]'}`}
                >
                  {post.fullText}
                </p>
                <button
                  type="button"
                  onClick={() => setExpanded((current) => ({ ...current, [post.id]: !isExpanded }))}
                  className="mt-2 text-[12px] font-medium text-primary"
                >
                  {isExpanded ? 'Show less' : 'Show full post'}
                </button>
              </div>

              <div className="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-muted-foreground">
                <span>{post.charCount} chars</span>
                <span>{post.hashtags.join(' ')}</span>
                <span>
                  expires {formatDateTime(approval.expiresAt, timeZone)} ({hoursLeft}h)
                </span>
              </div>

              {approval.emailSentAt ? (
                <p className="flex items-center gap-1.5 text-[11px] text-success-foreground">
                  <Mail className="h-3.5 w-3.5" aria-hidden /> Approval email sent{' '}
                  {formatDateTime(approval.emailSentAt, timeZone)}
                </p>
              ) : (
                <div className="flex flex-wrap items-center justify-between gap-2 rounded-md bg-warning-soft px-2.5 py-1.5 text-[12px] text-warning-foreground">
                  <span className="flex items-center gap-1.5">
                    <MailWarning className="h-3.5 w-3.5" aria-hidden /> Approval email was not
                    delivered.
                  </span>
                  <Button size="sm" variant="ghost" loading={busy} onClick={() => resend(post.id)}>
                    Send again
                  </Button>
                </div>
              )}

              <PostActions
                post={post}
                onDone={reload}
                onOptimistic={(status) => {
                  // Reverting to the original status means the request failed: bring the card back.
                  if (status === post.status) {
                    setDecided((current) => {
                      const next = { ...current };
                      delete next[post.id];
                      return next;
                    });
                    setLocalStatus((current) => {
                      const next = { ...current };
                      delete next[post.id];
                      return next;
                    });
                    return;
                  }
                  setLocalStatus((current) => ({ ...current, [post.id]: status }));
                  setDecided((current) => ({ ...current, [post.id]: true }));
                }}
              />

              <div className="flex justify-end">
                <Button size="sm" variant="ghost" loading={busy} onClick={() => resend(post.id)}>
                  Resend email
                </Button>
              </div>
            </CardContent>
          </Card>
        );
      })}
    </div>
  );
}
