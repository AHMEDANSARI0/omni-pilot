@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 0 0% 100%;
    --foreground: 240 10% 8%;
    --card: 0 0% 100%;
    --card-foreground: 240 10% 8%;
    --primary: 221 83% 53%;
    --primary-foreground: 0 0% 100%;
    --secondary: 240 5% 96%;
    --secondary-foreground: 240 6% 20%;
    --muted: 240 5% 96%;
    --muted-foreground: 240 4% 46%;
    --accent: 221 83% 96%;
    --accent-foreground: 221 83% 30%;
    --destructive: 0 72% 51%;
    --destructive-foreground: 0 0% 100%;
    --border: 240 6% 90%;
    --input: 240 6% 88%;
    --ring: 221 83% 53%;
  }

  * {
    @apply border-border;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    @apply bg-background text-foreground antialiased;
    font-family:
      ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial,
      'Noto Sans', sans-serif;
    overflow-x: hidden;
  }

  /* Never allow horizontal scrolling on small screens. */
  main,
  section,
  article,
  div {
    min-width: 0;
  }

  ::selection {
    @apply bg-blue-100 text-blue-900;
  }
}

@layer utilities {
  .safe-bottom {
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
}
