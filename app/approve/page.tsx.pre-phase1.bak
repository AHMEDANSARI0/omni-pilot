'use client';

import * as React from 'react';
import { Check, ShieldCheck, X } from 'lucide-react';
import { api } from '@/lib/api';
import type { ApprovalPreviewDto, DecisionResponseDto } from '@/lib/types';
import { Alert, Button, Card, CardContent, Skeleton, Textarea } from '@/components/ui/primitives';

export default function ApprovalPage() {
  const [token, setToken] = React.useState<string | null>(null);
  const [intent, setIntent] = React.useState<string | null>(null);
  const [preview, setPreview] = React.useState<ApprovalPreviewDto | null>(null);
  const [loading, setLoading] = React.useState(true);
  const [error, setError] = React.useState<string | null>(null);
  const [busy, setBusy] = React.useState(false);
  const [decision, setDecision] = React.useState<DecisionResponseDto | null>(null);
  const [showReject, setShowReject] = React.useState(false);
  const [note, setNote] = React.useState('');

  React.useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    const value = params.get('token');
    setIntent(params.get('intent'));
    setToken(value);
    if (!value) {
      setLoading(false);
      setError('This link is missing its approval token.');
      return;
    }
    api
      .public<ApprovalPreviewDto>(`/public/approvals/${encodeURIComponent(value)}`)
      .then((result) => {
        setPreview(result);
        setShowReject(params.get('intent') === 'reject');
      })
      .catch((caught: unknown) =>
        setError(caught instanceof Error ? caught.message : 'Could not load this approval'),
      )
      .finally(() => setLoading(false));
  }, []);

  const decide = async (action: 'approve' | 'reject') => {
    if (!token) return;
    setBusy(true);
    setError(null);
    try {
      const result = await api.publicPost<DecisionResponseDto>(
        `/public/approvals/${encodeURIComponent(token)}/decision`,
        { action, ...(note.trim() ? { note: note.trim() } : {}) },
      );
      setDecision(result);
      setPreview((current) => (current ? { ...current, state: 'used', action } : current));
    } catch (caught) {
      setError(caught instanceof Error ? caught.message : 'Action failed');
    } finally {
      setBusy(false);
    }
  };

  return (
    <div className="mx-auto flex min-h-screen w-full max-w-xl flex-col px-4 py-6">
      <header className="mb-4">
        <p className="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
          LinkedIn Automation
        </p>
        <h1 className="mt-1 text-lg font-semibold">
          {decision
            ? decision.action === 'approve'
              ? 'Approved'
              : 'Rejected'
            : 'Review this post'}
        </h1>
      </header>

      {loading ? <Skeleton className="h-64 w-full" /> : null}

      {!loading && error ? (
        <Alert tone="error" title="Something is wrong with this link">
          {error}
        </Alert>
      ) : null}

      {!loading && decision ? (
        <div className="space-y-3">
          <Alert
            tone={decision.action === 'approve' ? 'success' : 'info'}
            title={decision.action === 'approve' ? 'Approval recorded' : 'Rejection recorded'}
          >
            {decision.publish?.message ??
              (decision.action === 'approve' ? 'Publishing is queued.' : 'Nothing was published.')}
          </Alert>
          <Card>
            <CardContent className="space-y-2 p-4">
              <div className="flex items-center justify-between text-[12px] text-muted-foreground">
                <span>{decision.post.runDate}</span>
                <span className="capitalize">{decision.post.status.replace('_', ' ')}</span>
              </div>
              {decision.post.publishedUrl ? (
                <a
                  href={decision.post.publishedUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="break-all text-[13px] text-primary underline-offset-2 hover:underline"
                >
                  {decision.post.publishedUrl}
                </a>
              ) : null}
              <p className="text-[12px] text-muted-foreground">
                You can close this page. The dashboard always has the current state.
              </p>
            </CardContent>
          </Card>
        </div>
      ) : null}

      {!loading && !decision && preview && preview.post ? (
        <div className="space-y-3">
          <Card>
            <CardContent className="space-y-2 p-4">
              <div className="flex items-center justify-between text-[12px] text-muted-foreground">
                <span>{preview.post.runDate}</span>
                <span>
                  {preview.post.charCount} chars · {preview.post.hashtags.length} hashtags
                </span>
              </div>
              <div className="whitespace-pre-wrap break-words rounded-lg border border-border bg-muted/40 p-3 text-[13.5px] leading-relaxed">
                {preview.post.fullText}
              </div>
              {preview.expiresAt ? (
                <p className="text-[11px] text-muted-foreground">
                  Link expires {new Date(preview.expiresAt).toLocaleString('en-GB')}
                </p>
              ) : null}
            </CardContent>
          </Card>

          {preview.state === 'actionable' ? (
            <>
              <Alert tone="info" title="Nothing is published yet">
                Approving publishes this text exactly as shown. Rejecting keeps it unpublished and
                marks the topic as skipped.
              </Alert>

              {showReject ? (
                <Card>
                  <CardContent className="space-y-2 p-4">
                    <p className="text-[13px] font-medium">Reject this post?</p>
                    <Textarea
                      rows={2}
                      value={note}
                      placeholder="Optional note (kept in the audit log)"
                      onChange={(event) => setNote(event.target.value)}
                    />
                    <div className="flex gap-2">
                      <Button
                        variant="ghost"
                        className="flex-1"
                        onClick={() => setShowReject(false)}
                      >
                        Cancel
                      </Button>
                      <Button
                        variant="outline"
                        className="flex-1"
                        loading={busy}
                        onClick={() => decide('reject')}
                      >
                        <X className="h-4 w-4" aria-hidden /> Confirm reject
                      </Button>
                    </div>
                  </CardContent>
                </Card>
              ) : null}

              <div className="grid grid-cols-2 gap-2">
                <Button
                  variant="success"
                  size="lg"
                  loading={busy}
                  onClick={() => decide('approve')}
                >
                  <Check className="h-5 w-5" aria-hidden /> Approve
                </Button>
                <Button
                  variant="outline"
                  size="lg"
                  loading={busy}
                  onClick={() => setShowReject(true)}
                >
                  <X className="h-5 w-5" aria-hidden /> Reject
                </Button>
              </div>

              <p className="flex items-start gap-1.5 px-1 text-[11px] text-muted-foreground">
                <ShieldCheck className="mt-0.5 h-3.5 w-3.5 shrink-0" aria-hidden />
                This link is single-use, expires automatically, and only an explicit action here can
                publish.
                {intent === 'reject' ? ' You opened the reject link from your email.' : ''}
              </p>
            </>
          ) : (
            <Alert
              tone={preview.state === 'used' ? 'info' : 'warning'}
              title={`Link ${preview.state}`}
            >
              {preview.message}
            </Alert>
          )}
        </div>
      ) : null}
    </div>
  );
}
