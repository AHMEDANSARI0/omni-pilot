'use client';

import * as React from 'react';
import { useRouter } from 'next/navigation';
import { ArrowRight, CalendarClock, ShieldCheck, Sparkles, Zap } from 'lucide-react';
import { fetchAuthMode, signIn } from '@/lib/api';
import type { AuthMode } from '@/lib/session';
import { Alert, Button, Field, Input } from '@/components/ui/primitives';

const HIGHLIGHTS = [
  { icon: Sparkles, title: 'AI drafts', detail: 'Gemini writes in your voice' },
  { icon: CalendarClock, title: 'Cloud schedule', detail: 'Publishes with no laptop on' },
  { icon: ShieldCheck, title: 'Email approval', detail: 'Nothing posts without your tap' },
];

export default function SignInPage() {
  const router = useRouter();
  const [mode, setMode] = React.useState<AuthMode | null>(null);
  const [email, setEmail] = React.useState('');
  const [password, setPassword] = React.useState('');
  const [error, setError] = React.useState<string | null>(null);
  const [busy, setBusy] = React.useState(false);

  React.useEffect(() => {
    fetchAuthMode()
      .then((result) => {
        setMode(result);
        if (!result.requiresAuth) router.replace('/');
      })
      .catch((caught: unknown) =>
        setError(caught instanceof Error ? caught.message : 'Cannot reach the API'),
      );
  }, [router]);

  const submit = async (event: React.FormEvent) => {
    event.preventDefault();
    setBusy(true);
    setError(null);
    try {
      await signIn(email.trim(), password);
      router.replace('/');
    } catch (caught) {
      setError(caught instanceof Error ? caught.message : 'Sign in failed');
    } finally {
      setBusy(false);
    }
  };

  return (
    <div className="flex min-h-screen flex-col lg:flex-row">
      <aside className="relative hidden flex-1 flex-col justify-between overflow-hidden bg-gradient-to-br from-indigo-600 via-indigo-600 to-violet-600 p-10 text-white lg:flex">
        <div
          aria-hidden
          className="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-white/10 blur-2xl"
        />
        <div
          aria-hidden
          className="pointer-events-none absolute -bottom-32 -left-16 h-96 w-96 rounded-full bg-violet-400/20 blur-3xl"
        />

        <div className="relative flex items-center gap-2.5">
          <span className="flex h-9 w-9 items-center justify-center rounded-xl bg-white/15 backdrop-blur">
            <Zap className="h-[18px] w-[18px]" aria-hidden />
          </span>
          <span className="text-[15px] font-semibold tracking-tight">PostPilot</span>
        </div>

        <div className="relative max-w-md">
          <h1 className="text-[30px] font-semibold leading-tight tracking-tight">
            Your LinkedIn pipeline, on autopilot.
          </h1>
          <p className="mt-3 text-[14px] leading-relaxed text-white/80">
            Plan in Google Sheets, let Gemini write, approve from your phone, publish through the
            official LinkedIn API.
          </p>

          <ul className="mt-8 space-y-3">
            {HIGHLIGHTS.map((item) => (
              <li key={item.title} className="flex items-center gap-3">
                <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white/12 backdrop-blur">
                  <item.icon className="h-4 w-4" aria-hidden />
                </span>
                <span className="min-w-0">
                  <span className="block text-[13px] font-medium">{item.title}</span>
                  <span className="block text-[12px] text-white/70">{item.detail}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>

        <p className="relative text-[11.5px] text-white/60">
          Free-tier infrastructure · personal use only
        </p>
      </aside>

      <main className="flex flex-1 flex-col justify-center bg-canvas px-5 py-10 sm:px-8">
        <div className="mx-auto w-full max-w-sm">
          <div className="mb-7 flex items-center gap-2.5 lg:hidden">
            <span className="flex h-9 w-9 items-center justify-center rounded-xl bg-primary text-primary-foreground shadow-sm">
              <Zap className="h-[18px] w-[18px]" aria-hidden />
            </span>
            <span className="text-[15px] font-semibold tracking-tight">PostPilot</span>
          </div>

          <h2 className="text-[22px] font-semibold tracking-tight">Sign in</h2>
          <p className="mt-1 text-[13px] text-muted-foreground">
            Owner account only. Create the user in Supabase Auth first.
          </p>

          <form onSubmit={submit} className="mt-6 space-y-3.5">
            <Field label="Email" htmlFor="email">
              <Input
                id="email"
                type="email"
                autoComplete="username"
                inputMode="email"
                required
                value={email}
                onChange={(event) => setEmail(event.target.value)}
                placeholder={mode?.ownerEmailHint ?? 'you@example.com'}
                className="h-11"
              />
            </Field>
            <Field label="Password" htmlFor="password">
              <Input
                id="password"
                type="password"
                autoComplete="current-password"
                required
                value={password}
                onChange={(event) => setPassword(event.target.value)}
                className="h-11"
              />
            </Field>

            {error ? <Alert tone="error">{error}</Alert> : null}
            {mode && !mode.supabaseConfigured ? (
              <Alert tone="warning" title="Supabase Auth not configured">
                Set SUPABASE_ANON_KEY on the server, then create the owner user in the Supabase
                dashboard.
              </Alert>
            ) : null}

            <Button type="submit" className="h-11 w-full" loading={busy}>
              Sign in
              <ArrowRight className="h-4 w-4" aria-hidden />
            </Button>
          </form>

          <p className="mt-6 text-[11.5px] leading-relaxed text-muted-foreground">
            Local development runs without a login (
            <code className="rounded bg-muted px-1">ALLOW_DEV_BYPASS=true</code>). This switch is
            rejected when <code className="rounded bg-muted px-1">APP_ENV=production</code>.
          </p>
        </div>
      </main>
    </div>
  );
}
