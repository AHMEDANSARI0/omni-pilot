openapi: 3.0.3
info:
  title: LinkedIn Automation API
  version: 1.0.0
  description: |
    Internal, versioned API for the personal LinkedIn automation system.
    Personal use only: no public developer platform, billing or API marketplace.

    All responses use `{ ok: true, data }` or `{ ok: false, error: { code, message, details } }`.
servers:
  - url: /api/v1
security:
  - bearerAuth: []
tags:
  - name: Public
  - name: Overview
  - name: Content
  - name: Schedule
  - name: Approvals
  - name: Publishing
  - name: Integrations
  - name: Settings
  - name: Logs

paths:
  /health:
    get:
      tags: [Public]
      security: []
      summary: Liveness and configuration sanity
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema: { $ref: '#/components/schemas/Health' }

  /auth/mode:
    get:
      tags: [Public]
      security: []
      summary: Whether the dashboard requires sign-in
      responses:
        '200': { description: OK }

  /auth/login:
    post:
      tags: [Public]
      security: []
      summary: Owner sign-in through Supabase Auth
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [email, password]
              properties:
                email: { type: string, format: email }
                password: { type: string, minLength: 6 }
      responses:
        '200': { description: Session issued }
        '401': { $ref: '#/components/responses/Error' }
        '403': { $ref: '#/components/responses/Error' }
        '429': { $ref: '#/components/responses/Error' }

  /public/approvals/{token}:
    get:
      tags: [Public]
      security: []
      summary: Read-only preview for the email approval page
      parameters:
        - $ref: '#/components/parameters/Token'
      responses:
        '200':
          description: Preview with state actionable|expired|used|invalid
        '404': { $ref: '#/components/responses/Error' }

  /public/approvals/{token}/decision:
    post:
      tags: [Public]
      security: []
      summary: Approve or reject a post (single-use token, POST only)
      parameters:
        - $ref: '#/components/parameters/Token'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [action]
              properties:
                action: { type: string, enum: [approve, reject] }
                note: { type: string, maxLength: 1000 }
      responses:
        '200': { description: Decision recorded }
        '409': { $ref: '#/components/responses/Error' }
        '410': { $ref: '#/components/responses/Error' }
        '429': { $ref: '#/components/responses/Error' }

  /overview:
    get:
      tags: [Overview]
      summary: Dashboard aggregate (stats, schedule, integrations, latest posts, logs)
      responses:
        '200': { description: OK }
        '401': { $ref: '#/components/responses/Error' }

  /content/topics:
    get:
      tags: [Content]
      summary: List topics
      parameters:
        - { in: query, name: status, schema: { type: string }, description: Comma separated statuses }
        - { in: query, name: from, schema: { type: string, format: date } }
        - { in: query, name: to, schema: { type: string, format: date } }
        - { in: query, name: limit, schema: { type: integer, maximum: 200 } }
      responses:
        '200': { description: OK }
    post:
      tags: [Content]
      summary: Add a topic manually
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [topicDate, topic]
              properties:
                topicDate: { type: string, format: date }
                topic: { type: string, minLength: 5, maxLength: 300 }
                contentType:
                  type: string
                  enum: [insight, story, how-to, opinion, case-note, list, question]
                keyPoints: { type: string, nullable: true }
                targetAudience: { type: string, nullable: true }
      responses:
        '201': { description: Created }
        '409': { $ref: '#/components/responses/Error' }
        '422': { $ref: '#/components/responses/Error' }

  /content/topics/{id}:
    patch:
      tags: [Content]
      summary: Reset a topic (pending|skipped)
      parameters:
        - { in: path, name: id, required: true, schema: { type: string, format: uuid } }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [status]
              properties:
                status: { type: string, enum: [pending, skipped] }
      responses:
        '200': { description: OK }

  /content/topics/{id}/retry:
    post:
      tags: [Content]
      summary: Reset a failed topic to pending
      parameters:
        - { in: path, name: id, required: true, schema: { type: string, format: uuid } }
      responses:
        '200': { description: OK }

  /content/posts:
    get:
      tags: [Content]
      summary: List generated posts
      parameters:
        - { in: query, name: status, schema: { type: string } }
        - { in: query, name: from, schema: { type: string, format: date } }
        - { in: query, name: to, schema: { type: string, format: date } }
        - { in: query, name: limit, schema: { type: integer, maximum: 200 } }
        - { in: query, name: offset, schema: { type: integer, minimum: 0 } }
      responses:
        '200': { description: OK }

  /content/posts/{id}:
    get:
      tags: [Content]
      summary: Post with topic, approval and job
      parameters:
        - { in: path, name: id, required: true, schema: { type: string, format: uuid } }
      responses:
        '200': { description: OK }
        '404': { $ref: '#/components/responses/Error' }
    patch:
      tags: [Content]
      summary: Edit post text (revalidated, marked edited)
      parameters:
        - { in: path, name: id, required: true, schema: { type: string, format: uuid } }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [fullText]
              properties:
                fullText: { type: string, minLength: 50, maxLength: 3000 }
      responses:
        '200': { description: Updated }
        '409': { $ref: '#/components/responses/Error' }
        '422': { $ref: '#/components/responses/Error' }

  /content/sync:
    post:
      tags: [Content]
      summary: Import eligible rows from Google Sheets
      responses:
        '200': { description: Sync result with counts and row issues }
        '502': { $ref: '#/components/responses/Error' }

  /content/generate:
    post:
      tags: [Content]
      summary: Run the generation pipeline now
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                runDate: { type: string, format: date }
                sendEmail: { type: boolean }
                skipSync: { type: boolean }
      responses:
        '200': { description: GenerationResult (generated|duplicate|no_topic|failed) }

  /content/stats:
    get:
      tags: [Content]
      summary: Post counts by status
      responses:
        '200': { description: OK }

  /schedule:
    get:
      tags: [Schedule]
      summary: Schedule overview and recent runs
      responses:
        '200': { description: OK }

  /schedule/run:
    post:
      tags: [Schedule]
      summary: Run one automation tick
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                force: { type: boolean }
                runDate: { type: string, format: date }
      responses:
        '200': { description: TickResult }

  /schedule/cron:
    post:
      tags: [Schedule]
      summary: Cron entry point (shared secret)
      security:
        - cronSecret: []
      responses:
        '200': { description: TickResult }
        '401': { $ref: '#/components/responses/Error' }

  /approvals:
    get:
      tags: [Approvals]
      summary: Approvals with their posts
      parameters:
        - { in: query, name: status, schema: { type: string, default: pending } }
        - { in: query, name: limit, schema: { type: integer, maximum: 200 } }
      responses:
        '200': { description: OK }

  /approvals/{postId}/decision:
    post:
      tags: [Approvals]
      summary: Approve or reject from the dashboard
      parameters:
        - { in: path, name: postId, required: true, schema: { type: string, format: uuid } }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [action]
              properties:
                action: { type: string, enum: [approve, reject] }
                note: { type: string, maxLength: 1000 }
      responses:
        '200': { description: DecisionOutcome }
        '409': { $ref: '#/components/responses/Error' }
        '410': { $ref: '#/components/responses/Error' }

  /approvals/{postId}/resend:
    post:
      tags: [Approvals]
      summary: Rotate the token and re-send the approval email
      parameters:
        - { in: path, name: postId, required: true, schema: { type: string, format: uuid } }
      responses:
        '200': { description: '{ sent, error, expiresAt }' }
        '409': { $ref: '#/components/responses/Error' }

  /publishing/jobs:
    get:
      tags: [Publishing]
      summary: Publishing jobs
      parameters:
        - { in: query, name: status, schema: { type: string } }
        - { in: query, name: limit, schema: { type: integer, maximum: 200 } }
      responses:
        '200': { description: OK }

  /publishing/history:
    get:
      tags: [Publishing]
      summary: Published posts with LinkedIn URLs
      responses:
        '200': { description: OK }

  /publishing/posts/{postId}/publish:
    post:
      tags: [Publishing]
      summary: Publish an approved post now (idempotent)
      parameters:
        - { in: path, name: postId, required: true, schema: { type: string, format: uuid } }
      responses:
        '200': { description: PublishOutcome }
        '409': { $ref: '#/components/responses/Error' }

  /publishing/posts/{postId}/retry:
    post:
      tags: [Publishing]
      summary: Requeue a failed post
      parameters:
        - { in: path, name: postId, required: true, schema: { type: string, format: uuid } }
      responses:
        '200': { description: '{ post, job }' }
        '409': { $ref: '#/components/responses/Error' }

  /publishing/posts/{postId}/manual:
    post:
      tags: [Publishing]
      summary: Record a manual publish URL
      parameters:
        - { in: path, name: postId, required: true, schema: { type: string, format: uuid } }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [url]
              properties:
                url: { type: string, format: uri, description: LinkedIn post URL }
      responses:
        '200': { description: '{ post, job }' }
        '409': { $ref: '#/components/responses/Error' }
        '422': { $ref: '#/components/responses/Error' }

  /integrations:
    get:
      tags: [Integrations]
      summary: Integration status (no credentials)
      responses:
        '200': { description: OK }

  /integrations/whatsapp/webhook:
    get:
      tags: [Integrations]
      security: []
      summary: Meta webhook verification handshake
      parameters:
        - { in: query, name: 'hub.mode', schema: { type: string } }
        - { in: query, name: 'hub.verify_token', schema: { type: string } }
        - { in: query, name: 'hub.challenge', schema: { type: string } }
      responses:
        '200': { description: Challenge echoed back }
        '403': { description: Verify token mismatch or not configured }
    post:
      tags: [Integrations]
      security: []
      summary: Inbound WhatsApp messages (HMAC-signed by Meta)
      parameters:
        - { in: header, name: X-Hub-Signature-256, schema: { type: string } }
      responses:
        '200': { description: '{ ok: true, processed: n }' }
        '401': { $ref: '#/components/responses/Error' }
        '503': { $ref: '#/components/responses/Error' }

  /whatsapp/status:
    get:
      tags: [Integrations]
      summary: WhatsApp channel status (masked number, webhook URL, secret flags)
      responses:
        '200': { description: OK }

  /whatsapp/test:
    post:
      tags: [Integrations]
      summary: Send one test message to the owner number
      responses:
        '200': { description: '{ ok, message }' }

  /integrations/{provider}/authorize:
    get:
      tags: [Integrations]
      summary: Start OAuth (returns a URL to open)
      parameters:
        - { in: path, name: provider, required: true, schema: { type: string, enum: [google_sheets, linkedin] } }
        - { in: query, name: redirect, schema: { type: string } }
      responses:
        '200': { description: '{ url }' }

  /integrations/{provider}/callback:
    get:
      tags: [Integrations]
      security: []
      summary: OAuth callback (state-verified, redirects to settings)
      parameters:
        - { in: path, name: provider, required: true, schema: { type: string, enum: [google_sheets, linkedin] } }
        - { in: query, name: code, schema: { type: string } }
        - { in: query, name: state, schema: { type: string } }
      responses:
        '302': { description: Redirect to the dashboard }

  /integrations/google-sheets/config:
    post:
      tags: [Integrations]
      summary: Set the target spreadsheet and tab
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                sheetId: { type: string }
                sheetUrl: { type: string, format: uri }
                sheetTab: { type: string }
      responses:
        '200': { description: OK }
        '422': { $ref: '#/components/responses/Error' }

  /integrations/{provider}/test:
    post:
      tags: [Integrations]
      summary: Live connectivity test
      parameters:
        - { in: path, name: provider, required: true, schema: { type: string, enum: [google_sheets, linkedin, resend, gemini] } }
      responses:
        '200': { description: '{ provider, ok, message }' }

  /integrations/{provider}:
    delete:
      tags: [Integrations]
      summary: Disconnect a provider
      parameters:
        - { in: path, name: provider, required: true, schema: { type: string, enum: [google_sheets, linkedin] } }
      responses:
        '200': { description: Disconnected }

  /settings:
    get:
      tags: [Settings]
      summary: Read settings
      responses:
        '200': { description: OK }
    patch:
      tags: [Settings]
      summary: Update settings (partial)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                ownerTimezone: { type: string }
                generationTime: { type: string, example: '08:00' }
                publishTime: { type: string, example: '09:30' }
                publishDays: { type: array, items: { type: integer, minimum: 1, maximum: 7 } }
                respectPublishTime: { type: boolean }
                autoPublishOnApproval: { type: boolean }
                approvalTtlHours: { type: integer, minimum: 1, maximum: 336 }
                aiModel: { type: string }
                brandVoice: { type: string }
                writingInstructions: { type: string }
                hashtagMin: { type: integer, minimum: 1, maximum: 10 }
                hashtagMax: { type: integer, minimum: 1, maximum: 10 }
                maxPostChars: { type: integer, minimum: 300, maximum: 3000 }
                emailNotifications: { type: boolean }
      responses:
        '200': { description: Updated settings }
        '422': { $ref: '#/components/responses/Error' }

  /settings/schedule:
    get:
      tags: [Settings]
      summary: Schedule overview
      responses:
        '200': { description: OK }

  /settings/health:
    get:
      tags: [Settings]
      summary: Integration health summary
      responses:
        '200': { description: OK }

  /logs:
    get:
      tags: [Logs]
      summary: Execution logs
      parameters:
        - { in: query, name: level, schema: { type: string, enum: [debug, info, warn, error] } }
        - { in: query, name: event, schema: { type: string } }
        - { in: query, name: limit, schema: { type: integer, maximum: 500 } }
      responses:
        '200': { description: OK }

components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: Supabase JWT
    cronSecret:
      type: apiKey
      in: header
      name: x-cron-secret
  parameters:
    Token:
      in: path
      name: token
      required: true
      schema: { type: string, pattern: '^[A-Za-z0-9_-]{43}$' }
  responses:
    Error:
      description: Error envelope
      content:
        application/json:
          schema: { $ref: '#/components/schemas/Error' }
  schemas:
    Error:
      type: object
      required: [ok, error]
      properties:
        ok: { type: boolean, enum: [false] }
        error:
          type: object
          required: [code, message]
          properties:
            code: { type: string }
            message: { type: string }
            details:
              type: object
              additionalProperties: true
    Health:
      type: object
      properties:
        ok: { type: boolean }
        data:
          type: object
          properties:
            status: { type: string }
            time: { type: string, format: date-time }
            appEnv: { type: string }
            servicesMode: { type: string, enum: [live, local] }
            aiProvider: { type: string }
            aiModel: { type: string }
            database:
              type: object
              properties:
                ok: { type: boolean }
                error: { type: string }
