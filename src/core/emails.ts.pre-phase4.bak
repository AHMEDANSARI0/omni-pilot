import type { EmailMessage } from './ports';
import type { Post, Settings, Topic } from './types';

function escapeHtml(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function formatInstant(iso: string, timeZone: string): string {
  return new Intl.DateTimeFormat('en-GB', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone,
  }).format(new Date(iso));
}

function layout(title: string, bodyHtml: string, footer: string): string {
  return `<!doctype html>
<html><body style="margin:0;padding:0;background:#f4f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f5;padding:16px 0;">
<tr><td align="center">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:12px;border:1px solid #e4e4e7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
<tr><td style="padding:20px 20px 8px 20px;">
<div style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#71717a;">LinkedIn Automation</div>
<h1 style="margin:8px 0 0 0;font-size:18px;line-height:1.35;color:#18181b;">${escapeHtml(title)}</h1>
</td></tr>
<tr><td style="padding:8px 20px 20px 20px;color:#27272a;font-size:15px;line-height:1.6;">${bodyHtml}</td></tr>
<tr><td style="padding:0 20px 20px 20px;color:#71717a;font-size:12px;line-height:1.5;">${footer}</td></tr>
</table>
</td></tr></table>
</body></html>`;
}

function button(href: string, label: string, color: string): string {
  return `<a href="${escapeHtml(href)}" style="display:inline-block;background:${color};color:#ffffff;text-decoration:none;font-weight:600;font-size:15px;padding:12px 20px;border-radius:8px;">${escapeHtml(label)}</a>`;
}

function postBlock(text: string): string {
  return `<div style="white-space:pre-wrap;background:#fafafa;border:1px solid #e4e4e7;border-radius:10px;padding:14px;font-size:15px;line-height:1.55;color:#18181b;">${escapeHtml(text)}</div>`;
}

export interface ApprovalEmailInput {
  post: Post;
  topic: Topic | null;
  reviewUrl: string;
  rejectUrl: string;
  expiresAt: string;
  settings: Settings;
  /** `wa.me` deep link with the short approval code pre-filled (WhatsApp channel). */
  whatsappUrl?: string | null;
}

export function buildApprovalEmail(input: ApprovalEmailInput): Omit<EmailMessage, 'to'> {
  const { post, topic, reviewUrl, rejectUrl, expiresAt, settings } = input;
  const whatsappUrl = input.whatsappUrl ?? null;
  const expiresLabel = formatInstant(expiresAt, settings.ownerTimezone);
  const publishLabel = `${settings.publishTime} (${settings.ownerTimezone})`;
  const topicLine = topic
    ? `<p style="margin:0 0 12px 0;color:#52525b;font-size:13px;">Topic: ${escapeHtml(topic.topic)}</p>`
    : '';

  const html = layout(
    `Approve today's LinkedIn post (${post.runDate})`,
    `${topicLine}
${postBlock(post.fullText)}
<p style="margin:16px 0 12px 0;color:#52525b;font-size:13px;">${post.charCount} characters · ${post.hashtags.length} hashtags · generated by ${escapeHtml(post.model || post.provider)}</p>
<p style="margin:0 0 14px 0;">${button(reviewUrl, 'Review and approve', '#2563eb')}</p>
<p style="margin:0 0 14px 0;">${button(rejectUrl, 'Review and reject', '#71717a')}</p>
${whatsappUrl ? `<p style="margin:0 0 6px 0;">${button(whatsappUrl, 'Approve on WhatsApp', '#1f9d55')}</p><p style="margin:0 0 14px 0;color:#52525b;font-size:13px;">WhatsApp opens with the code already typed: send it and the bot replies with this post plus Approve / Reject buttons. Free to use.</p>` : ''}
<p style="margin:0;color:#52525b;font-size:13px;">Nothing is published until you approve. After approval the post goes out at ${escapeHtml(publishLabel)} (or immediately if that time has passed). This link expires ${escapeHtml(expiresLabel)}.</p>`,
    `If the buttons do not work, open this link: ${escapeHtml(reviewUrl)}<br/>Sent because automated LinkedIn publishing is enabled for your account.`,
  );

  const text = [
    `Approve today's LinkedIn post (${post.runDate})`,
    '',
    post.fullText,
    '',
    `${post.charCount} characters · ${post.hashtags.length} hashtags`,
    `Review and approve: ${reviewUrl}`,
    `Review and reject: ${rejectUrl}`,
    ...(whatsappUrl ? [`Approve on WhatsApp: ${whatsappUrl}`] : []),
    '',
    `Nothing is published until you approve. Publish time: ${publishLabel}.`,
    `This link expires ${expiresLabel}.`,
  ].join('\n');

  return {
    subject: `Approve LinkedIn post for ${post.runDate}: ${truncate(post.hook, 70)}`,
    html,
    text,
  };
}

export interface DecisionReceiptInput {
  action: 'approve' | 'reject';
  post: Post;
  publishStatus: string;
  publishedUrl?: string | null;
  settings: Settings;
}

export function buildDecisionReceiptEmail(input: DecisionReceiptInput): Omit<EmailMessage, 'to'> {
  const { action, post, publishStatus, publishedUrl, settings } = input;
  const title = action === 'approve' ? 'Post approved' : 'Post rejected';
  const statusLine =
    action === 'approve'
      ? publishedUrl
        ? `Published: <a href="${escapeHtml(publishedUrl)}" style="color:#2563eb;">${escapeHtml(publishedUrl)}</a>`
        : `Publishing status: ${escapeHtml(publishStatus)}`
      : 'No publishing action was taken. The topic is marked as skipped.';

  const html = layout(
    `${title} (${post.runDate})`,
    `<p style="margin:0 0 14px 0;">${statusLine}</p>${postBlock(post.fullText)}`,
    `Recorded at ${escapeHtml(formatInstant(new Date().toISOString(), settings.ownerTimezone))}.`,
  );

  return {
    subject: `${title} - ${post.runDate}`,
    html,
    text: `${title} (${post.runDate})\n\n${post.fullText}\n\n${replaceTags(statusLine)}`,
  };
}

export function buildPublishedEmail(
  post: Post,
  url: string,
  settings: Settings,
): Omit<EmailMessage, 'to'> {
  const html = layout(
    `Published to LinkedIn (${post.runDate})`,
    `<p style="margin:0 0 14px 0;">The approved post is live: <a href="${escapeHtml(url)}" style="color:#2563eb;">${escapeHtml(url)}</a></p>${postBlock(post.fullText)}`,
    `Published at ${escapeHtml(formatInstant(new Date().toISOString(), settings.ownerTimezone))}.`,
  );
  return {
    subject: `Published - ${post.runDate}`,
    html,
    text: `Published to LinkedIn (${post.runDate})\n\n${url}\n\n${post.fullText}`,
  };
}

export function buildManualPublishEmail(
  post: Post,
  reason: string,
  settings: Settings,
): Omit<EmailMessage, 'to'> {
  const linkedInComposer = 'https://www.linkedin.com/feed/?shareActive=true';
  const html = layout(
    `Manual publish needed (${post.runDate})`,
    `<p style="margin:0 0 12px 0;">${escapeHtml(reason)}</p>
${postBlock(post.fullText)}
<p style="margin:16px 0 0 0;">${button(linkedInComposer, 'Open LinkedIn and paste', '#0a66c2')}</p>
<p style="margin:14px 0 0 0;color:#52525b;font-size:13px;">Copy the post above, publish it manually, then record the URL in the dashboard so the history stays accurate.</p>`,
    'The automation never fakes a successful publish.',
  );
  return {
    subject: `Manual publish needed - ${post.runDate}`,
    html,
    text: `Manual publish needed (${post.runDate})\n\nReason: ${reason}\n\n${post.fullText}\n\nOpen ${linkedInComposer}`,
  };
}

export function buildFailureEmail(input: {
  runDate: string;
  stage: string;
  message: string;
  settings: Settings;
  dashboardUrl: string;
}): Omit<EmailMessage, 'to'> {
  const html = layout(
    `Automation failure: ${input.stage}`,
    `<p style="margin:0 0 12px 0;">Run date <strong>${escapeHtml(input.runDate)}</strong> failed during <strong>${escapeHtml(input.stage)}</strong>.</p>
<div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:14px;color:#7f1d1d;font-size:14px;">${escapeHtml(input.message)}</div>
<p style="margin:16px 0 0 0;">${button(input.dashboardUrl, 'Open dashboard', '#2563eb')}</p>`,
    'You are receiving this because failure notifications are enabled.',
  );
  return {
    subject: `Automation failure at ${input.stage} - ${input.runDate}`,
    html,
    text: `Run ${input.runDate} failed during ${input.stage}.\n\n${input.message}\n\nDashboard: ${input.dashboardUrl}`,
  };
}

export function buildLinkedInExpiryEmail(input: {
  expiresAt: string;
  daysLeft: number;
  authorizeUrl: string;
  settings: Settings;
}): Omit<EmailMessage, 'to'> {
  const html = layout(
    'LinkedIn authorization expires soon',
    `<p style="margin:0 0 12px 0;">The LinkedIn access token expires on <strong>${escapeHtml(formatInstant(input.expiresAt, input.settings.ownerTimezone))}</strong> (${input.daysLeft} days).</p>
<p style="margin:0 0 16px 0;">LinkedIn self-serve apps do not get refresh tokens, so publishing stops when the token expires unless you reconnect.</p>
${button(input.authorizeUrl, 'Reconnect LinkedIn', '#0a66c2')}`,
    'Reconnecting takes about 30 seconds.',
  );
  return {
    subject: `LinkedIn access expires in ${input.daysLeft} days`,
    html,
    text: `LinkedIn access token expires ${input.expiresAt} (${input.daysLeft} days).\nReconnect: ${input.authorizeUrl}`,
  };
}

export function buildNoTopicEmail(input: {
  runDate: string;
  detail: string;
  settings: Settings;
  sheetUrl: string | null;
}): Omit<EmailMessage, 'to'> {
  const html = layout(
    'No topic available for today',
    `<p style="margin:0 0 12px 0;">Run date <strong>${escapeHtml(input.runDate)}</strong> had no eligible topic, so nothing was generated.</p>
<p style="margin:0 0 12px 0;color:#52525b;font-size:14px;">${escapeHtml(input.detail)}</p>
${input.sheetUrl ? `<p style="margin:0 0 16px 0;">${button(input.sheetUrl, 'Open Google Sheet', '#0f9d58')}</p>` : ''}`,
    'Add a row with a future DATE and STATUS set to Pending to resume automation.',
  );
  return {
    subject: `No topic for ${input.runDate}`,
    html,
    text: `No eligible topic for ${input.runDate}.\n${input.detail}`,
  };
}

function truncate(value: string, max: number): string {
  return value.length <= max ? value : `${value.slice(0, max - 1)}…`;
}

function replaceTags(html: string): string {
  return html.replace(/<[^>]+>/g, '');
}
